      "version": 1,
      "versionNonce": 1165,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "XOR of rows GPU 0, GPU 1, GPU 3 and parity = the original value.\nThe same XOR runs over all 4,096 values of the piece.\nAt TP=8 a rebuild reads 7 pieces + 1 parity piece = 64 KiB.",
      "originalText": "XOR of rows GPU 0, GPU 1, GPU 3 and parity = the original value.\nThe same XOR runs over all 4,096 values of the piece.\nAt TP=8 a rebuild reads 7 pieces + 1 parity piece = 64 KiB.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
